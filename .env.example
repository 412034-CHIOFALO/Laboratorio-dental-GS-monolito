# Copiar a ".env" en el VPS y completar con valores reales. Nunca commitear el ".env" real.
# Fuera del perfil "dev" la app NO arranca si algún secreto queda vacío, con
# menos de 8 caracteres, con su default o con "cambiar-esto" (ver
# SecretosProduccionValidator) — el error dice exactamente cuáles faltan.

# IMPORTANTE: sin esto, la app arranca en profile "dev" y carga datos de
# prueba falsos (odontólogos, pedidos, usuarios semilla) en la base real.
SPRING_PROFILES_ACTIVE=prod

GS_IMAGE=ghcr.io/412034-chiofalo/laboratorio-dental-gs-monolito:latest
GS_FRONTEND_IMAGE=ghcr.io/412034-chiofalo/laboratorio-dental-gs-monolito-frontend:latest

DB_HOST=mysql
DB_PORT=3306
DB_NAME=gs_auth
# Contraseña de root de MySQL. La usan: el propio contenedor mysql (bootstrap),
# el contenedor de backup (mysqldump necesita leer las 5 bases completas) y
# docker-entrypoint-initdb.d/init-schemas.sh (crea el usuario de app de abajo).
# La app en sí NUNCA se conecta como root.
DB_ROOT_PASSWORD=cambiar-esto
# Usuario/contraseña con los que la APP se conecta a MySQL en runtime. Se crea
# solo al primer arranque (init-schemas.sh) con privilegios acotados a las 5
# bases gs_* — sin acceso a mysql.*/information_schema ni a otras bases del
# servidor, a diferencia de root.
DB_USERNAME=gs_app
DB_PASSWORD=cambiar-esto

# DOMAIN tiene que ser el mismo dominio que apunta acá por DNS y que el que
# aparece en AUTH_ISSUER de abajo — lo usan docker-compose.https.yml (nginx +
# certbot) e init-letsencrypt.sh para emitir el certificado real. Sin esto
# bien seteado no hay HTTPS, y sin HTTPS nadie puede loguearse (ver
# gs.auth.cookie-secure en application.properties). LETSENCRYPT_EMAIL es solo
# para el aviso de Let's Encrypt si el certificado está por vencer sin renovarse.
DOMAIN=tu-dominio.com
LETSENCRYPT_EMAIL=vos@tu-dominio.com

AUTH_ISSUER=https://tu-dominio.com
# Contraseña del keystore que firma las sesiones (se genera solo en el volumen
# app_keys la primera vez que arranca la app). Obligatoria fuera de "dev".
# Si ya había un keystore creado con OTRA contraseña (ej. el default viejo
# gs_keystore_2025), la app no lo va a poder abrir: borrá el volumen
# (`docker volume rm <proyecto>_app_keys`) y se regenera solo con esta — lo
# único que pasa es que todos tienen que volver a loguearse.
GS_KEYSTORE_PASSWORD=cambiar-esto
GS_TOKEN_TTL_HOURS=12
GS_REFRESH_TTL_DAYS=30

GS_ADMIN_PASSWORD=cambiar-esto
GS_TECNICO_PASSWORD=cambiar-esto
GS_BOT_PEDIDOS_PASSWORD=cambiar-esto
GS_INTERNAL_API_KEY=cambiar-esto

MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=cambiar-esto
MINIO_ROOT_PASSWORD=cambiar-esto
MINIO_ENABLED=true
MINIO_BUCKET_FINANZAS=comprobantes
MINIO_BUCKET_PEDIDOS=documentos-pedidos

GS_BOT_API_KEY=cambiar-esto
# BOT_URI ya no va acá: docker-compose.yml lo fija a http://gs-bot:3001.

# --- Bot de WhatsApp (opcional: todo tiene default en docker-compose.yml) ---
# BOT_BACKEND_ENABLED=false  → el bot solo loguea lo que detecta, sin registrar nada
# BOT_GRUPOS=Comprobantes Transferencias,Comprobantes Efectivo
# BOT_GRUPOS_EFECTIVO=Comprobantes Efectivo
# BOT_GRUPOS_JIDS=           → "nombre:jid,..." si getChats() de whatsapp-web.js falla
# IA para leer comprobantes de cualquier billetera (key de https://aistudio.google.com/apikey)
# GEMINI_API_KEY=
# GEMINI_ENABLED=true

BACKUP_URI=http://backup:3002

# --- Observabilidad (opcional, apagada por default) --------------------------
# Métricas y trazas por OTLP + logs por el driver "loki" de Docker (ver
# docker-compose.observability.yml). Sacar los 3 valores de Grafana Cloud
# (plan gratis: https://grafana.com/auth/sign-up/create-user), stack nueva →
# Connections → OpenTelemetry (endpoint + header) y → Loki (URL con user:token).
# Sin esto seteado, la app sigue arrancando normal — solo no manda nada.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-sa-east-1.grafana.net/otlp
GRAFANA_OTLP_AUTH_HEADER=Basic cambiar-esto-por-el-base64-real
LOKI_URL=https://cambiar-usuario:cambiar-token@logs-prod-XXX.grafana.net/loki/api/v1/push
