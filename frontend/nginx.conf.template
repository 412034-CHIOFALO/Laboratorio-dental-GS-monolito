# ═══════════════════════════════════════════════════════════════════════════
#   nginx — sirve el SPA Angular y hace proxy al monolito (antes: api-gateway)
#
#   Es un ".template": la imagen oficial de nginx corre envsubst sobre este
#   archivo al arrancar el container (reemplaza los ${VAR} por las variables
#   de entorno reales) y escribe el resultado en /etc/nginx/conf.d/default.conf.
#   Así el X-Bot-Api-Key no queda hardcodeado en el repo.
# ═══════════════════════════════════════════════════════════════════════════

server {
    listen       80;
    # Con templates, el script automático de la imagen que agrega soporte IPv6
    # no llega a correr (necesita que exista /etc/nginx/conf.d/default.conf,
    # y con templates ese archivo recién se genera después) — sin esta línea
    # nginx queda escuchando solo en IPv4 y el healthcheck (que pega a
    # "localhost", que adentro del container resuelve primero a ::1) falla.
    listen       [::]:80;
    server_name  localhost;

    # Challenge HTTP-01 de Let's Encrypt (certbot). En dev local nadie pega
    # acá; en prod esta config solo se usa antes de tener el primer
    # certificado (ver docker-entrypoint.sh) — una vez que existe, se pasa a
    # nginx.https.conf.template, que tiene su propio bloque igual a este para
    # las renovaciones.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Usado por el HEALTHCHECK del Dockerfile — un path fijo que responde 200
    # sin redirigir, igual en este template y en nginx.https.conf.template
    # (ahí, todo lo demás en :80 redirige a https).
    location = /healthz {
        access_log off;
        return 200 "ok";
        add_header Content-Type text/plain;
    }

    # Headers de seguridad — sin Strict-Transport-Security acá a propósito: no
    # tiene efecto sobre HTTP plano (los browsers lo ignoran si no vino por
    # HTTPS) y este template es el que usa tanto dev local como el arranque de
    # bootstrap en prod antes del primer certificado. Ver nginx.https.conf.template
    # para el resto de la explicación de la CSP.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://images.unsplash.com; media-src 'self'; connect-src 'self'; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'" always;

    # Tamaño máximo de body para uploads (fotos de catálogo, comprobantes,
    # escaneos 3D — los STL/PLY de alta resolución pueden pesar bastante más que 10MB)
    client_max_body_size 200M;

    # Compresión gzip para reducir el peso de los chunks de Angular
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml application/json application/javascript application/xml+rss text/javascript image/svg+xml;

    # ─── SPA Angular ──────────────────────────────────────────────────────
    # Todos los archivos estáticos se sirven desde /usr/share/nginx/html.
    # try_files redirige cualquier ruta desconocida a index.html para que
    # el Router de Angular maneje la navegación client-side.
    location / {
        root   /usr/share/nginx/html;
        index  index.html;
        try_files $uri $uri/ /index.html;

        # No cachear el index.html para que los deploys se vean al instante
        location = /index.html {
            add_header Cache-Control "no-cache, no-store, must-revalidate";
            add_header Pragma "no-cache";
            add_header Expires "0";
        }
    }

    # Cache largo para assets con hash (Angular genera nombres con hash en prod)
    location ~* \.(js|css|woff2?|ttf|eot|svg|png|jpg|jpeg|gif|ico)$ {
        root /usr/share/nginx/html;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # ─── Proxy al monolito: rutas /api/** ──────────────────────────────────
    # El frontend hace fetch('/api/catalogo/...') y nginx lo reenvía al
    # monolito (antes iba al api-gateway, que ya no existe). Sin CORS porque
    # comparten origin desde el browser. Incluye auth, catalogo, pedidos,
    # finanzas, stock y odontologos — todo vive en el mismo proceso ahora.
    location /api/ {
        # Resolución DNS en runtime (DNS embebido de Docker) + variable en el
        # proxy_pass → nginx NO resuelve 'app' al arrancar, sino en cada
        # request. Así el frontend no crashea si el monolito todavía no levantó.
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $app_upstream app;
        proxy_pass         http://$app_upstream:8080;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        # Generoso para subir/descargar archivos grandes (escaneos 3D STL/PLY)
        proxy_send_timeout    120s;
        proxy_read_timeout    120s;
        # Sin esto nginx bufferea el archivo ENTERO (a disco si es grande) antes de
        # siquiera empezar a mandarlo al monolito/devolverlo al navegador — para un
        # STL de varios MB eso agrega una escritura+lectura de disco completa de más
        # antes de que arranque la transferencia real. Con esto se hace streaming directo.
        proxy_request_buffering off;
        proxy_buffering         off;
    }

    # ─── Proxy al actuator del monolito: /actuator/** ──────────────────────
    # Solo /actuator/health e /actuator/info quedan expuestos acá (ver
    # management.endpoints.web.exposure.include en application.properties) —
    # útil para pegarle desde afuera (verificación manual, un uptime monitor
    # externo) sin necesidad de exponer el puerto 8080 del backend.
    location /actuator/ {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $app_upstream app;
        proxy_pass         http://$app_upstream:8080;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_connect_timeout 5s;
        proxy_send_timeout    10s;
        proxy_read_timeout    10s;
    }

    # ─── Proxy al bot de WhatsApp: /api/bot/** ─────────────────────────────
    # Antes lo manejaba el api-gateway directo (routes[6] en su application.properties):
    # Path=/api/bot/** → BOT_URI, con AddRequestHeader X-Bot-Api-Key. El bot sigue
    # siendo un proceso Node aparte (no se fusionó al monolito), así que nginx
    # reproduce exactamente esa misma ruta + header ahora que el gateway no está.
    # Requiere que el servicio se llame "gs-bot" en la red de docker-compose
    # (si el bot no está levantado, esta ruta simplemente da error — no rompe nada más).
    location /api/bot/ {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $bot_upstream gs-bot;
        proxy_pass         http://$bot_upstream:3001;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   X-Bot-Api-Key     "${GS_BOT_API_KEY}";
        proxy_connect_timeout 5s;
        proxy_send_timeout    30s;
        proxy_read_timeout    30s;
    }

    # ─── Error pages ──────────────────────────────────────────────────────
    error_page  500 502 503 504  /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}
