# ═══════════════════════════════════════════════════════════════════════════
#   nginx — misma app que nginx.conf.template, pero sirviendo HTTPS real.
#
#   docker-entrypoint.sh elige este template en vez del plano SOLO cuando ya
#   existe un certificado real emitido para $DOMAIN (ver ese script) — hasta
#   entonces (dev local, o el primer arranque en prod antes de correr
#   init-letsencrypt.sh) se usa nginx.conf.template sin tocar nada.
# ═══════════════════════════════════════════════════════════════════════════

# Puerto 80: solo redirige a HTTPS, salvo el challenge de renovación (certbot
# vuelve a pedir por HTTP-01 cada vez que renueva, no solo la primera vez).
server {
    listen       80;
    listen       [::]:80;
    server_name  ${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Usado por el HEALTHCHECK del Dockerfile — no redirige, a diferencia de
    # todo lo demás en este bloque :80.
    location = /healthz {
        access_log off;
        return 200 "ok";
        add_header Content-Type text/plain;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen       443 ssl;
    listen       [::]:443 ssl;
    server_name  ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # Headers de seguridad (HSTS + los de nginx-seguridad.conf, ahí se explica
    # la CSP). Hay que repetir el include en cada location que use add_header:
    # nginx no los hereda del server en esos casos, y así fue como el index.html
    # salía sin ninguno.
    include /etc/nginx/snippets/seguridad-https.conf;

    # Tamaño máximo de body para uploads (fotos de catálogo, comprobantes,
    # escaneos 3D — los STL/PLY de alta resolución pueden pesar bastante más que 10MB)
    client_max_body_size 200M;

    # Compresión gzip para reducir el peso de los chunks de Angular
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml application/json application/javascript application/xml+rss text/javascript image/svg+xml;

    # ─── SPA Angular ──────────────────────────────────────────────────────
    location / {
        root   /usr/share/nginx/html;
        index  index.html;
        try_files $uri $uri/ /index.html;

        location = /index.html {
            include /etc/nginx/snippets/seguridad-https.conf;
            add_header Cache-Control "no-cache, no-store, must-revalidate";
            add_header Pragma "no-cache";
            add_header Expires "0";
        }
    }

    # Cache largo para assets con hash (Angular genera nombres con hash en prod)
    location ~* \.(js|css|woff2?|ttf|eot|svg|png|jpg|jpeg|gif|ico)$ {
        root /usr/share/nginx/html;
        expires 1y;
        include /etc/nginx/snippets/seguridad-https.conf;
        add_header Cache-Control "public, immutable";
    }

    # ─── Proxy al monolito: rutas /api/** ──────────────────────────────────
    location /api/ {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $app_upstream app;
        proxy_pass         http://$app_upstream:8080;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout    120s;
        proxy_read_timeout    120s;
        proxy_request_buffering off;
        proxy_buffering         off;
    }

    # ─── Proxy al actuator del monolito: /actuator/** ──────────────────────
    # Solo /actuator/health e /actuator/info quedan expuestos (ver
    # management.endpoints.web.exposure.include en application.properties).
    location /actuator/ {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $app_upstream app;
        proxy_pass         http://$app_upstream:8080;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_connect_timeout 5s;
        proxy_send_timeout    10s;
        proxy_read_timeout    10s;
    }

    # ─── Proxy al bot de WhatsApp: /api/bot/** ─────────────────────────────
    # Solo las 3 rutas del panel y solo con sesión de ADMIN/ADMINISTRATIVO —
    # ver el comentario completo en nginx.conf.template.
    location = /_auth_bot {
        internal;
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $app_upstream app;
        proxy_pass              http://$app_upstream:8080/api/auth/bot-acceso;
        proxy_method            GET;
        proxy_pass_request_body off;
        proxy_set_header        Content-Length    "";
        proxy_set_header        Host              $host;
        proxy_set_header        X-Real-IP         $remote_addr;
        proxy_set_header        X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header        X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout    10s;
    }

    location ~ ^/api/bot/(estado|regenerar-qr|reconciliar)$ {
        auth_request /_auth_bot;
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $bot_upstream gs-bot;
        proxy_pass         http://$bot_upstream:3001;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   X-Bot-Api-Key     "${GS_BOT_API_KEY}";
        proxy_connect_timeout 5s;
        proxy_send_timeout    30s;
        proxy_read_timeout    30s;
    }

    location /api/bot/ {
        return 404;
    }

    # ─── Error pages ──────────────────────────────────────────────────────
    error_page  500 502 503 504  /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}
